HOST=127.0.0.1
PORT=3000
INFERENCE_API_KEY=replace-with-a-long-random-secret
METRICS_TOKEN=replace-with-a-different-random-secret
CODEX_ENABLED=true
CODEX_MODEL=gpt-6.1-sol
CODEX_MODELS=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_SERVICE_TIER=default
CLAUDE_ENABLED=true
CLAUDE_MODEL=sonnet
CLAUDE_MODELS=sonnet,opus,haiku
CLAUDE_REASONING_EFFORT=medium
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=120000
MAX_CONCURRENT_REQUESTS=2
RATE_LIMIT_PER_MINUTE=120
SHUTDOWN_GRACE_MS=30000
# DEFAULT_MODEL=claude/sonnet
# Native paths default to the CLIs installed by npm.
# CODEX_PATH=/absolute/path/to/codex
# CLAUDE_PATH=/absolute/path/to/claude
# Local defaults use ~/.harness-relay and its claude subdirectory.
# Containers use the persistent /state volume instead.
# CLAUDE_CREDENTIAL_FILE=/run/secrets/claude-credential.json
# Alternatively inject ONE of these through your secret manager:
# CLAUDE_CODE_OAUTH_TOKEN=...
# ANTHROPIC_API_KEY=...
