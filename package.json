{
  "name": "harness-relay",
  "version": "0.2.0",
  "description": "OpenAI-compatible inference relay for Codex and Claude Agent SDK",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "smoke:live": "node --env-file-if-exists=.env scripts/smoke.mjs --live",
    "release:check": "node scripts/release-check.mjs",
    "auth": "node --env-file-if-exists=.env scripts/auth.mjs",
    "auth:status": "node --env-file-if-exists=.env scripts/auth.mjs status",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/claude-code": "^2.1.296",
    "@clack/prompts": "^1.8.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@openai/codex-sdk": "0.163.0",
    "@prometheus-io/client": "^0.16.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express-rate-limit": "^8.7.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.spec.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skadi-1894/harness-relay.git"
  },
  "homepage": "https://github.com/skadi-1894/harness-relay#readme",
  "bugs": {
    "url": "https://github.com/skadi-1894/harness-relay/issues"
  },
  "keywords": [
    "codex",
    "inference",
    "openai-compatible",
    "cli",
    "nestjs",
    "harness"
  ]
}
